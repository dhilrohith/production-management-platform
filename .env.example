# Application Server Config
PORT=3000
NODE_ENV=development

# Database Config (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=b2b_manufacturing_db

# Security & Auth (JWT + Refresh Tokens)
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-replace-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Configuration (Multer / Local Disk)
STORAGE_PATH=./uploads

# Apache Kafka Broker Configuration
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=b2b-manufacturing-service
KAFKA_GROUP_ID=b2b-manufacturing-group

# SMTP Stub (Password Reset / Email Notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=stub_user
SMTP_PASS=stub_pass
